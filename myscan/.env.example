# MyScan environment configuration (example).
# Copy to .env (or export) and adjust. Never commit real secrets.

# ---- API server ----
# Bind address/port for the waitress server (run_api.py).
MYSCAN_HOST=0.0.0.0
MYSCAN_PORT=8443
MYSCAN_DEBUG=0

# ---- Security layer (src/security.py) ----
# When set, ALL /api/* routes require this key (Bearer / Basic / X-API-Key / ?token=).
# Leave empty to disable auth (not recommended for anything but local dev).
MYSCAN_API_KEY=

# Rate limiting per client IP.
MYSCAN_RATE_LIMIT=300
MYSCAN_RATE_LIMIT_BURST=60

# Comma-separated list of allowed CORS origins (e.g. the frontend URL).
MYSCAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Semicolon-separated allowlist of local paths that may be scanned.
MYSCAN_ALLOWED_PATHS=

# Set "1" to trust X-Forwarded-For headers (needed behind a reverse proxy).
MYSCAN_TRUST_PROXY=0

# ---- Persistence (src/store.py) ----
# SQLite database path (defaults to src/myscan.db).
MYSCAN_DB=

# ---- LLM enhancement (src/ai/enhancer.py) ----
# Optional AI explanations. Provider keys: OPENAI_API_KEY / ANTHROPIC_API_KEY /
# GOOGLE_API_KEY (or GEMINI_API_KEY). Set MYSCAN_LLM_ENHANCE=0 to disable even
# when a provider key is present.
MYSCAN_LLM_ENHANCE=1
MYSCAN_LLM_MAX_FINDINGS=20
MYSCAN_LLM_TIMEOUT=30
MYSCAN_LLM_CONCURRENCY=4

# ---- Frontend (frontend/src/proxy.ts) ----
# API base URL the frontend proxy forwards to, and the API key it injects.
API_BASE_URL=http://localhost:8443
MYSCAN_API_KEY=
